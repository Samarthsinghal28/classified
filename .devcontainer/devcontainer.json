{
  "name": "ElizaOS - SSH Enabled",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "automatic",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [2222, 5432, 7777, 5173],
  "portsAttributes": {
    "2222": {
      "label": "SSH Server",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "notify"
    },
    "7777": {
      "label": "AgentServer API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Game Frontend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-ossdata.vscode-postgresql"
      ]
    }
  },
  "remoteUser": "codespace",
  "containerUser": "codespace",
  "updateRemoteUserUID": false,
  "postCreateCommand": "echo 'SSH-enabled devcontainer created successfully!' && sudo service ssh restart && whoami && echo 'SSH_CONNECTION:' $SSH_CONNECTION"
}
