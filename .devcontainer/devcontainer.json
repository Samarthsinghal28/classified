{
  "name": "ElizaOS - SSH Preserved",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "automatic",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [2222, 5432, 7777, 5173],
  "portsAttributes": {
    "2222": {
      "label": "SSH Server",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "notify"
    },
    "7777": {
      "label": "AgentServer API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Game Frontend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-ossdata.vscode-postgresql"
      ]
    }
  },
  "remoteUser": "codespace",
  "containerUser": "codespace",
  "updateRemoteUserUID": false,
  "postCreateCommand": "sudo service postgresql start && sudo -u postgres psql -c \"CREATE ROLE eliza WITH LOGIN PASSWORD 'eliza_secure_pass' CREATEDB;\" && sudo -u postgres psql -c \"CREATE DATABASE eliza OWNER eliza;\" && sudo -u postgres psql -d eliza -c \"CREATE EXTENSION IF NOT EXISTS \\\"uuid-ossp\\\";\" && sudo -u postgres psql -d eliza -c \"CREATE EXTENSION IF NOT EXISTS \\\"pg_trgm\\\";\" || true"
}
